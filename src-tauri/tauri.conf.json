{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudStream Desktop",
  "version": "0.1.0",
  "identifier": "com.lagradost.cloudstream.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CloudStream Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "libmpv/libmpv-2.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Lagradost",
    "homepage": "https://github.com/recloudstream/cloudstream",
    "shortDescription": "CloudStream Desktop - Stream movies and TV shows",
    "longDescription": "CloudStream Desktop is a powerful streaming app with support for multiple providers, subtitles, and watch history.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
